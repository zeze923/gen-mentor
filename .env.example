# === LLM API 配置（必须配置至少一个）===

# 方案 A：使用 DeepSeek（推荐，性价比高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 方案 B：使用 OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# 方案 C：使用 Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# === 搜索配置（二选一）===

# 方案 A（推荐）：DuckDuckGo — 无需 API Key，直接可用
# 方案 B：SearXNG — 需要自建服务

# === 其他配置 ===
LOCAL_EMBEDDING_MODEL_PATH=    # 可选，本地嵌入模型路径
